node_modules/
.DS_Store

# build output
build/
dist/
.react-router/
storybook-static/
# Subsetted Caprasimo, regenerated from DISPLAY_STRINGS by predev/prebuild
# (scripts/subsetCaprasimo.ts) — never committed, so it can't drift stale
# against the enum it's derived from.
/public/fonts/generated/
# Lighthouse CI reports — uploaded as a workflow artifact, never committed
.lighthouseci/
# Downloaded baseline for the PR-vs-base-branch comparison, and the rendered
# summary handed to the sticky PR comment — both regenerated every run.
lighthouse-baseline/
lighthouse-summary.md

# env + secrets
.env
.env.*
!.env.example

# prisma / sqlite
*.db
*.db-journal
*.db-shm
*.db-wal
prisma/migrations/dev.db*
# the generated client — rebuilt by `npm run db:generate`
/generated/prisma

# project-local gh config, if we scope the CLI here
.gh/

# claude code local overrides
.claude/settings.local.json

# Prisma vendors ~11k lines of its own agent skills on `prisma init` unless you
# pass --no-skills. They're package-level docs, not app source — install them at
# the user level (~/.claude/skills) if they're ever wanted. Ignored so a stray
# init can't quietly put them back. `.claude/skills/` is deliberately NOT
# ignored: that's where genuine project skills would live.
/.agents/
/skills-lock.json

*storybook.log

# Swift build products — regenerated by `swift build`/`xcodebuild`.
# Package.resolved IS committed (pinned dependency versions), and so is the
# swift-openapi-generator plugin's own output — it's a build plugin, not a
# separate `generate` script, so there's no source of truth for
# ios/Sources/ReadingRigKit/{Types,Client,Server}.swift other than .build/.
ios/.build/
ios/.swiftpm/
ios/DerivedData/
