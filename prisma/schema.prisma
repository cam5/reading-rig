// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// The seam auth arrives through — real now: app/user.server.ts's
// requireUser() reads a session cookie and resolves it to a row here.
// Every other model already carried a userId from its first migration, so
// accounts turned out to be exactly the addition the original comment
// promised, not a refactor.
model User {
  id               String            @id @default(cuid())
  email            String            @unique
  createdAt        DateTime          @default(now())
  works            Work[]
  readingPositions ReadingPosition[]
  highlights       Highlight[]
  entries          Entry[]
  rigSessions      RigSession[]
  workGrants       WorkGrant[]
}

// A magic-link sign-in request. Keyed by email rather than userId — the
// email may not have a User yet (first sign-in doubles as sign-up), and
// app/magicLink.server.ts creates the User only once the link is clicked,
// never when the link is merely requested. tokenHash is a sha256 of the
// token that actually goes out in the email URL; the raw token is never
// persisted, so a leaked database dump can't be replayed as a valid link.
model MagicLinkToken {
  id          String    @id @default(cuid())
  email       String
  tokenHash   String    @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
}

// Work -> Chapter -> Section -> Paragraph is the normalised text tree an
// EPUB ingests into (app/domain/epub/parseEpub.ts). Every locator in the
// design ("§4 ¶3") is derived from a Section's label and a Paragraph's
// ordinal — never stored as a string.
//
// Work.id is content-addressed from the book's own OPF identifier (see
// deriveWorkId), not random — the same book re-ingested resolves to the
// same row. That's deliberately a single-owner simplification: if a second
// user ever ingests the same public-domain book, they'd collide on this id
// and reassign ownership. Fine for one user; a real multi-tenant model
// would split a de-duplicated, content-addressed text table from a
// per-user shelf/copy join table. Deferred until accounts exist — building
// that split now would be speculative.
//
// ownerId is who ingested this Work, not who's allowed to act on it —
// those are different questions once a Work can be shared. Highlight and
// Entry each carry their own userId (the author) rather than inheriting
// ownership transitively, and app/domain/work/workAccessWhere.server.ts
// is the seam that answers "may this user load/annotate this Work" —
// ownerId OR a WorkGrant row, now that grants exist (see WorkGrant below).
model Work {
  id               String            @id
  ownerId          String
  owner            User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title            String
  author           String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  chapters         Chapter[]
  readingPositions ReadingPosition[]
  rigSessions      RigSession[]
  grants           WorkGrant[]

  // Seed-library books (ingested once under a library account, e.g. the
  // three Standard Ebooks titles) — scripts/seedLibrary.ts grants these to
  // every existing user at seed time and app/routes/auth.verify.tsx grants
  // them to every user at sign-in, so new accounts start with a shelf
  // instead of an empty one. Not meant for anything a real owner ingests.
  isSeedWork       Boolean           @default(false)

  // JSON-encoded string[] from ParsedWork.warnings (app/domain/epub/types.ts)
  // — null/empty means parseEpub hit nothing structurally ambiguous. Not a
  // confidence score: each entry names a specific, itemized uncertainty
  // (e.g. a chapter file with more than one top-level chapter section)
  // rather than a single number with no principled basis.
  ingestWarnings String?

  // The OPF manifest's cover-image item (see ParsedWork.cover in
  // app/domain/epub/types.ts), stored inline as a BLOB rather than a
  // filesystem/CDN path — there's no asset pipeline in this project, and a
  // personal-scale shelf's covers are small enough that a DB row is
  // simpler than standing one up. Null/null together means the source
  // epub declared no cover at all; never set independently of each other.
  coverImage     Bytes?
  coverMediaType String?

  @@index([ownerId])
}

// Grants a User access to a Work beyond ownerId — the piece
// app/domain/paragraph/assertParagraphsAnnotatableBy.server.ts's and
// assertWorkReadableBy.server.ts's doc comments called out as "the one
// line that changes when sharing/granting exists." One row per (user,
// work); @@unique makes granting idempotent (createMany +
// skipDuplicates), which matters because auth.verify.tsx re-grants
// seed works on every login (it's an upsert, not a one-time create), not
// just the first.
model WorkGrant {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workId    String
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, workId])
  @@index([workId])
}

model Chapter {
  id       String    @id
  workId   String
  work     Work      @relation(fields: [workId], references: [id], onDelete: Cascade)
  label    String
  ordinal  Int
  sections Section[]

  @@unique([workId, ordinal])
  @@index([workId])
}

model Section {
  id         String      @id
  chapterId  String
  chapter    Chapter     @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  label      String
  ordinal    Int
  paragraphs Paragraph[]

  @@unique([chapterId, ordinal])
  @@index([chapterId])
}

enum ParagraphKind {
  prose
  sceneBreak
}

// Paragraph.id is the content-addressed hash from computeParagraphId — a
// re-ingest of the same file must resolve to the same id, or every
// existing highlight and note anchored to it would be orphaned.
model Paragraph {
  id               String            @id
  sectionId        String
  section          Section           @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  html             String
  text             String
  ordinal          Int
  globalOrdinal    Int
  // Precomputed at ingest (countWords over `text`) rather than derived on
  // read — progress/timeLeft math needs every paragraph's word count, but
  // windowed loads (app/domain/reading/contentWindow.ts) only ever hold
  // `text` in memory for a slice of the work, not the whole thing.
  wordCount        Int
  // What this row actually is. Almost every row is `prose` — actual
  // chapter text, addressable by highlights/notes/mentions/rig tools.
  // `sceneBreak` (source <hr>, see #139) exists purely to hold this row's
  // place in ordinal sequence, so the two neighboring paragraphs don't
  // silently concatenate — html/text are empty and wordCount is 0 for it,
  // and it is never a highlight/note/mention target.
  kind             ParagraphKind     @default(prose)
  // Only meaningful when kind is `prose`: source was a <p> nested inside a
  // <blockquote> (a letter, a quoted document) rather than direct chapter
  // prose — html/text/wordCount are still real content, this only changes
  // how the reader renders it.
  isBlockquote     Boolean           @default(false)
  highlightSpans   HighlightSpan[]
  entries          Entry[]
  readingPositions ReadingPosition[]
  footnotes        Footnote[]

  @@unique([sectionId, ordinal])
  @@index([sectionId])
}

// A footnote/endnote body, joined to the paragraph whose <sup
// data-footnote-ref> marker points at it (see sanitizeHtml.ts's
// rewriteFootnoteRefs) — kept out of Paragraph.html/text entirely so a
// footnote's own prose never bleeds into the owning paragraph's highlight
// offset math (see #138's investigation).
model Footnote {
  id          String    @id
  paragraphId String
  paragraph   Paragraph @relation(fields: [paragraphId], references: [id], onDelete: Cascade)
  // Matches the marker's data-footnote-ref, e.g. "note-1" — the endnotes
  // file's own <li id> from the source epub.
  refId       String
  html        String
  text        String
  // Reading-order position across the whole work, not a per-paragraph
  // count — a paragraph with two markers gets two Footnote rows with
  // consecutive ordinals, not two rows both numbered 1.
  ordinal     Int

  @@index([paragraphId])
}

enum HighlightRole {
  hand
  rig
}

// The thing the user made — a highlight can reach across paragraphs, so
// this row itself carries no offsets. Its per-paragraph reach lives in
// HighlightSpan, one row per paragraph touched.
//
// userId is the author, not the Work's owner — the two are only ever the
// same person today because there's no way yet for a non-owner to load a
// Work at all (see the ownerId comment on Work). Carrying it here directly,
// rather than inferring it transitively through paragraph -> ... -> work,
// is what lets a future shared session attribute each highlight to
// whoever actually made it.
model Highlight {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      HighlightRole
  createdAt DateTime        @default(now())
  spans     HighlightSpan[]
  entries   Entry[]

  @@index([userId])
}

// [startOffset, endOffset) into Paragraph.text — resolved client-side by
// app/domain/paragraph/resolveSelectionOffset.ts from a browser Range, and
// rendered back by mergeHighlights.ts. A paragraph a spanning highlight
// passes through entirely (neither the first nor last it touches) gets
// [0, paragraph.text.length): fully covered, not partially.
model HighlightSpan {
  id          String    @id @default(cuid())
  highlightId String
  highlight   Highlight @relation(fields: [highlightId], references: [id], onDelete: Cascade)
  paragraphId String
  paragraph   Paragraph @relation(fields: [paragraphId], references: [id], onDelete: Cascade)
  startOffset Int
  endOffset   Int

  @@unique([highlightId, paragraphId])
  @@index([paragraphId])
}

enum EntryOrigin {
  hand
  rig
}

// The schema's centre of gravity — the one record both the margin and the
// commonplace book render from. Screen 3a's small context line above each
// entry ("Rig · asked of §4 ¶3, with your March note in view · 12 Mar")
// renders entirely from these fields, which is why they're all
// captured at write time: that line cannot be truthfully reconstructed
// later from anything else.
//
// Anchors to a paragraph, not a character range — coarser than Highlight
// on purpose. An Entry is a note about a passage; the precise excerpt it
// was written against (when there is one) lives in contextSnapshot, not
// as a queryable offset pair.
//
// highlightId is the escape hatch from that coarseness: a note that's
// about a specific Highlight reuses its spans (however many paragraphs
// they reach) instead of Entry growing its own span table. Additive, not
// a replacement for anchorParagraphId — every Entry still anchors to one
// paragraph (the highlight's first, when it came from one); highlightId
// is only set when there's a highlight the note is actually about.
model Entry {
  id                String      @id @default(cuid())
  // The author — an Entry can stand alone (no highlightId), so it needs
  // its own userId rather than borrowing a Highlight's. See the same note
  // on Highlight.userId for why this isn't inferred through the Work.
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  origin            EntryOrigin
  body              String
  anchorParagraphId String
  anchorParagraph   Paragraph   @relation(fields: [anchorParagraphId], references: [id], onDelete: Cascade)
  highlightId       String?
  highlight         Highlight?  @relation(fields: [highlightId], references: [id], onDelete: SetNull)
  // Free-form: for a hand entry today, just the excerpt it was saved
  // against ({ excerpt }). M3's Rig entries will carry richer context
  // (which passages and prior entries were in view) in the same field.
  contextSnapshot   Json
  // M3's — no RigSession model exists yet to relate to. A plain nullable
  // field keeps the shape honest without inventing that table early.
  rigSessionId      String?
  // "woven into your note above" (3a) — a Rig entry incorporated into an
  // existing hand entry. Self-relation, buildable now even though nothing
  // sets it until M3.
  wovenIntoEntryId  String?
  wovenIntoEntry    Entry?      @relation("EntryWeave", fields: [wovenIntoEntryId], references: [id], onDelete: SetNull)
  wovenEntries      Entry[]     @relation("EntryWeave")
  createdAt         DateTime    @default(now())

  @@index([anchorParagraphId])
  @@index([highlightId])
  @@index([userId])
}

// The bookmark. One row per (user, work) — @@unique enforces that, so
// writing it is always an upsert, never an insert that could duplicate.
// paragraphId is where you left off; globalOrdinal is read off the
// referenced Paragraph at query time (app/domain/reading/bookmark.ts)
// rather than duplicated here, so it can never drift from the paragraph
// it points to.
model ReadingPosition {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workId      String
  work        Work      @relation(fields: [workId], references: [id], onDelete: Cascade)
  paragraphId String
  paragraph   Paragraph @relation(fields: [paragraphId], references: [id], onDelete: Cascade)
  updatedAt   DateTime  @updatedAt

  @@unique([userId, workId])
}

// One long-lived Anthropic Managed Agents session per (user, work) — #26.
// Created the first time the reader opens the Rig for a given book,
// resumed (never replaced) on every return: anthropicSessionId is the only
// field that matters for "resumed on return", and it's written once. The
// transcript that session accumulates on Anthropic's side *is* that book's
// reading history, per the build plan.
//
// agentVersion is kept as a String, not an Int, even though the SDK's
// Agent.version is a number — it mirrors READING_RIG_AGENT_VERSION as
// scripts/setup-agent.ts already writes it to .env (see envFile.ts), and
// nothing here does arithmetic on it; it's provenance for "which version of
// the agent was this session created against", read and compared as a
// string, same as the env var it comes from.
//
// A reader can hold more than one session per (user, work) — the session
// picker (#114's follow-up) needs somewhere to switch between, and "start a
// new conversation" needs to be able to add one rather than overwrite the
// only one allowed. No longer @@unique([userId, workId]): that constraint
// was the entire mechanism behind the old "created on first open, resumed
// on return, no third state" model, which this deliberately replaces with
// "most recent by createdAt is the default, but any of them can be
// resumed." The (userId, workId, createdAt) index below is what that
// default-to-most-recent lookup and the picker's listing both run on.
model RigSession {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workId             String
  work               Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  anthropicSessionId String
  agentVersion       String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  // Where in the book this conversation is "about," for the reading page's
  // margin bubble — a plain Paragraph.globalOrdinal, not a locator string
  // (ambiguous across chapters, see domain/locator.ts) and not a FK to
  // Paragraph (this is only ever compared against a viewport range or
  // another session's ordinal, never dereferenced back to paragraph
  // content). Null for every session created before this field existed
  // (left unanchored forever, no backfill) and for a session whose first
  // message hasn't been sent yet. Set once, from the earliest locator-
  // bearing pill in that first message, or the earliest on-screen
  // paragraph if it carried no pills at all — see api.v1.rig.tsx's action.
  anchorGlobalOrdinal Int?

  @@index([userId, workId, createdAt])
}

// The Rig's Anthropic Agent + Environment ids — a singleton, not a lookup
// table: `id` is always the literal "rig". Previously these lived in
// .env, written by scripts/setup-agent.ts and read from process.env by
// resolveRigSession — but a release container's .env write never reaches
// Railway's persisted Variables, so a deploy where the stored ids no
// longer resolve on Anthropic's side just recreates and abandons a fresh
// agent+environment, forever, every deploy after (#113's real root cause).
//
// Living in the same SQLite volume as everything else fixes that for free:
// scripts/setup-agent.ts already runs inside the runtime container after
// migrations apply, with the same DATABASE_URL, so this table is exactly
// as durable as RigSession is. It also lets a request that discovers a
// dead agent/environment self-heal immediately (ensureRigProvisioning in
// app/rig/rigProvisioning.ts) rather than waiting for the next deploy.
//
// agentVersion is Int here, not String like RigSession.agentVersion — this
// row is the authoritative live value; RigSession's copy is provenance
// only, frozen at whatever version was in effect when that session was
// created.
model RigProvisioning {
  id            String   @id
  agentId       String
  agentVersion  Int
  environmentId String
  updatedAt     DateTime @updatedAt
}
