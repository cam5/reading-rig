// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// The seam auth arrives through. A personal tool today — one seeded row,
// created by prisma/seed.ts and read by app/user.server.ts's requireUser()
// — but every other model carries a userId from its first migration, so
// accounts are an addition later, not a refactor.
model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  works     Work[]
}

// Work -> Chapter -> Section -> Paragraph is the normalised text tree an
// EPUB ingests into (app/domain/epub/parseEpub.ts). Every locator in the
// design ("§4 ¶3") is derived from a Section's label and a Paragraph's
// ordinal — never stored as a string.
//
// Work.id is content-addressed from the book's own OPF identifier (see
// deriveWorkId), not random — the same book re-ingested resolves to the
// same row. That's deliberately a single-owner simplification: if a second
// user ever ingests the same public-domain book, they'd collide on this id
// and reassign ownership. Fine for one user; a real multi-tenant model
// would split a de-duplicated, content-addressed text table from a
// per-user shelf/copy join table. Deferred until accounts exist — building
// that split now would be speculative.
model Work {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  author    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  chapters  Chapter[]

  // JSON-encoded string[] from ParsedWork.warnings (app/domain/epub/types.ts)
  // — null/empty means parseEpub hit nothing structurally ambiguous. Not a
  // confidence score: each entry names a specific, itemized uncertainty
  // (e.g. a chapter file with more than one top-level chapter section)
  // rather than a single number with no principled basis.
  ingestWarnings String?

  @@index([userId])
}

model Chapter {
  id       String    @id
  workId   String
  work     Work      @relation(fields: [workId], references: [id], onDelete: Cascade)
  label    String
  ordinal  Int
  sections Section[]

  @@unique([workId, ordinal])
  @@index([workId])
}

model Section {
  id         String      @id
  chapterId  String
  chapter    Chapter     @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  label      String
  ordinal    Int
  paragraphs Paragraph[]

  @@unique([chapterId, ordinal])
  @@index([chapterId])
}

// Paragraph.id is the content-addressed hash from computeParagraphId — a
// re-ingest of the same file must resolve to the same id, or every
// existing highlight and note anchored to it would be orphaned.
model Paragraph {
  id             String          @id
  sectionId      String
  section        Section         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  html           String
  text           String
  ordinal        Int
  globalOrdinal  Int
  highlightSpans HighlightSpan[]
  entries        Entry[]

  @@unique([sectionId, ordinal])
  @@index([sectionId])
}

enum HighlightRole {
  hand
  rig
}

// The thing the user made — a highlight can reach across paragraphs, so
// this row itself carries no offsets. Its per-paragraph reach lives in
// HighlightSpan, one row per paragraph touched. No userId: ownership comes
// transitively through paragraph -> section -> chapter -> work, the same
// as Chapter/Section/Paragraph themselves.
model Highlight {
  id        String          @id @default(cuid())
  role      HighlightRole
  createdAt DateTime        @default(now())
  spans     HighlightSpan[]
}

// [startOffset, endOffset) into Paragraph.text — resolved client-side by
// app/domain/paragraph/resolveSelectionOffset.ts from a browser Range, and
// rendered back by mergeHighlights.ts. A paragraph a spanning highlight
// passes through entirely (neither the first nor last it touches) gets
// [0, paragraph.text.length): fully covered, not partially.
model HighlightSpan {
  id          String    @id @default(cuid())
  highlightId String
  highlight   Highlight @relation(fields: [highlightId], references: [id], onDelete: Cascade)
  paragraphId String
  paragraph   Paragraph @relation(fields: [paragraphId], references: [id], onDelete: Cascade)
  startOffset Int
  endOffset   Int

  @@unique([highlightId, paragraphId])
  @@index([paragraphId])
}

enum EntryOrigin {
  hand
  rig
}

enum Posture {
  interrogate
  steelman
  connect
  closeRead
  context
  recap
}

// The schema's centre of gravity — the one record both the margin and the
// commonplace book render from. Screen 3a's small context line above each
// entry ("Interrogate · asked of §4 ¶3, with your March note in view ·
// 12 Mar") renders entirely from these fields, which is why they're all
// captured at write time: that line cannot be truthfully reconstructed
// later from anything else.
//
// Anchors to a paragraph, not a character range — coarser than Highlight
// on purpose. An Entry is a note about a passage; the precise excerpt it
// was written against (when there is one) lives in contextSnapshot, not
// as a queryable offset pair.
model Entry {
  id                String      @id @default(cuid())
  origin            EntryOrigin
  // Only set when origin is rig — M3's postures. Nullable rather than a
  // separate RigEntry/HandEntry split: one shape, one query, whichever
  // fields apply to how it was made.
  posture           Posture?
  body              String
  anchorParagraphId String
  anchorParagraph   Paragraph   @relation(fields: [anchorParagraphId], references: [id], onDelete: Cascade)
  // Free-form: for a hand entry today, just the excerpt it was saved
  // against ({ excerpt }). M3's Rig entries will carry richer context
  // (which passages and prior entries were in view) in the same field.
  contextSnapshot   Json
  // M3's — no RigSession model exists yet to relate to. A plain nullable
  // field keeps the shape honest without inventing that table early.
  rigSessionId      String?
  // "woven into your note above" (3a) — a Rig entry incorporated into an
  // existing hand entry. Self-relation, buildable now even though nothing
  // sets it until M3.
  wovenIntoEntryId  String?
  wovenIntoEntry    Entry?      @relation("EntryWeave", fields: [wovenIntoEntryId], references: [id], onDelete: SetNull)
  wovenEntries      Entry[]     @relation("EntryWeave")
  createdAt         DateTime    @default(now())

  @@index([anchorParagraphId])
}
