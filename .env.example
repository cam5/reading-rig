# Copy to .env. Prisma reads this via prisma.config.ts (which imports dotenv).
# A local SQLite file — the library and the commonplace book are one file you own.
DATABASE_URL="file:./dev.db"

# The Rig, from M3. ANTHROPIC_API_KEY is yours to set by hand — in deployed
# environments it's a Railway environment variable per environment, not
# committed here. The other three are written by `npm run agent:setup`
# (scripts/setup-agent.ts), which creates the Managed Agent and its
# environment (the container workspace every session provisions —
# `sessions.create`'s `environment_id`, needed by app/routes/rig.tsx even
# though the Rig only uses custom tools plus web search/fetch) once each,
# converging both in place on every re-run (skipping the update if nothing
# changed); neither is ever created in the request path. scripts/release.ts
# also runs this on every deploy, when ANTHROPIC_API_KEY is set for that
# environment.
# ANTHROPIC_API_KEY=
# READING_RIG_AGENT_ID=
# READING_RIG_AGENT_VERSION=
# READING_RIG_ENVIRONMENT_ID=
