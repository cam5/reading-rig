# Copy to .env. Prisma reads this via prisma.config.ts (which imports dotenv).
# A local SQLite file — the library and the commonplace book are one file you own.
DATABASE_URL="file:./dev.db"

# The Rig arrives in M3. Both are written by scripts/setup-agent.ts, which
# creates the Managed Agent once; they are not set by hand and the agent is
# never created in the request path.
# ANTHROPIC_API_KEY=
# READING_RIG_AGENT_ID=
# READING_RIG_AGENT_VERSION=
