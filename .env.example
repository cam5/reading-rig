# Copy to .env. Prisma reads this via prisma.config.ts (which imports dotenv).
# A local SQLite file — the library and the commonplace book are one file you own.
DATABASE_URL="file:./dev.db"

# The Rig, from M3. ANTHROPIC_API_KEY is yours to set by hand. The other two
# are written by `npm run agent:setup` (scripts/setup-agent.ts), which
# creates the Managed Agent once and updates it in place on every re-run;
# the agent is never created in the request path.
# ANTHROPIC_API_KEY=
# READING_RIG_AGENT_ID=
# READING_RIG_AGENT_VERSION=
