# Copy to .env. Prisma reads this via prisma.config.ts (which imports dotenv).
# A local SQLite file — the library and the commonplace book are one file you own.
DATABASE_URL="file:./dev.db"

# The Rig arrives in M3. Both are written by scripts/setup-agent.ts, which
# creates the Managed Agent once; they are not set by hand and the agent is
# never created in the request path.
# ANTHROPIC_API_KEY=
# READING_RIG_AGENT_ID=
# READING_RIG_AGENT_VERSION=

# Reporting (app/analytics.server.ts). Without the project key, track() is
# a no-op — no client, no network, nothing thrown — so dev, tests and CI
# never need a PostHog project. Set the key to start reporting; set the
# host too for EU Cloud (https://eu.i.posthog.com) or a self-hosted
# instance. US Cloud is the default and needs no POSTHOG_HOST.
# POSTHOG_PROJECT_API_KEY=
# POSTHOG_HOST=
