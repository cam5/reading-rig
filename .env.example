# Copy to .env. Prisma reads this via prisma.config.ts (which imports dotenv).
# A local SQLite file — the library and the commonplace book are one file you own.
DATABASE_URL="file:./dev.db"

# The Rig, from M3. Yours to set by hand — in deployed environments it's a
# Railway environment variable per environment, not committed here.
# `npm run agent:setup` (scripts/setup-agent.ts) creates the Managed Agent
# and its environment (the container workspace every session provisions —
# `sessions.create`'s `environment_id`, needed by app/routes/rig.tsx even
# though the Rig only uses custom tools plus web search/fetch) once each,
# converging both in place on every re-run (skipping the update if nothing
# changed); neither is ever created in the request path. scripts/release.ts
# also runs this on every deploy, when ANTHROPIC_API_KEY is set for that
# environment. The ids/version themselves live in the RigProvisioning DB
# table, not here — see that model's doc comment in prisma/schema.prisma.
# ANTHROPIC_API_KEY=

# Signs the session cookie (app/auth/session.server.ts) so it can't be
# forged or tampered with client-side. Required in production — the app
# refuses to boot without it there; falls back to an insecure dev value
# locally so `npm run dev` works without setup.
# SESSION_SECRET=

# Magic-link sign-in emails (app/email.server.ts), via Resend
# (https://resend.com). Without RESEND_API_KEY, sending is a no-op that
# logs the magic link to the console instead — dev/test/CI never need a
# Resend account. RESEND_FROM_EMAIL needs a domain verified with Resend to
# send to arbitrary addresses; unset, it falls back to "onboarding@resend.dev",
# which Resend only delivers to the account's own verified email.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# Reporting (app/analytics.server.ts). Without the project key, track() is
# a no-op — no client, no network, nothing thrown — so dev, tests and CI
# never need a PostHog project. Set the key to start reporting; set the
# host too for EU Cloud (https://eu.i.posthog.com) or a self-hosted
# instance. US Cloud is the default and needs no POSTHOG_HOST.
# POSTHOG_PROJECT_API_KEY=
# POSTHOG_HOST=

# Source maps for error tracking (vite.config.ts). A *personal* API key —
# "error tracking write" + "organization read" scopes — not the project key
# above; it uploads build artifacts rather than writing events. Without
# both vars set, the build just skips the upload, same no-op shape as
# POSTHOG_PROJECT_API_KEY above.
# POSTHOG_CLI_API_KEY=
# POSTHOG_CLI_PROJECT_ID=
