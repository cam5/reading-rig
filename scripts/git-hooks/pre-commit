#!/usr/bin/env bash
# Formats staged files with Prettier before they're committed — enforcement
# lives here rather than only in editor config, so it can't be skipped by
# forgetting to configure an editor. CI's `prettier --check` is the backstop
# for the case this hook itself gets bypassed (--no-verify, stale install).
# Installed by ../install-git-hooks.ts (run via `postinstall`) — this file
# is the checked-in source; .git/hooks/pre-commit is a copy of it, since
# git doesn't version hooks itself.
#
# Known limitation: if a file is only partially staged (some hunks staged,
# some not), this reformats and re-adds the whole working-tree file, which
# will pull the unstaged hunk into the commit too. Fine for this repo's
# scale; reach for lint-staged's stash-unstaged trick if that ever bites.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
PRETTIER="$REPO_ROOT/node_modules/.bin/prettier"

# No local prettier install (e.g. hooks symlinked before `npm install`
# finished) — don't block the commit over it.
[ -x "$PRETTIER" ] || exit 0

# Staged, non-deleted files only. (No `mapfile` — macOS ships bash 3.2 as
# /usr/bin/env bash, which predates it.)
FILES=()
while IFS= read -r file; do
  FILES+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACM)
[ "${#FILES[@]}" -eq 0 ] && exit 0

"$PRETTIER" --write --ignore-unknown -- "${FILES[@]}"
git add -- "${FILES[@]}"

exit 0
