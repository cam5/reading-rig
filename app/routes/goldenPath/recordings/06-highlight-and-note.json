{
  "scenario": "06-highlight-and-note",
  "steps": [
    {
      "label": "a highlight in the first paragraph",
      "method": "POST",
      "path": "/api/v1/read/golden-author/the-golden-path",
      "status": 200,
      "contentType": "application/json",
      "cookie": "none",
      "json": {
        "shape": {
          "ok": "boolean"
        },
        "literals": {
          "ok": true
        }
      }
    },
    {
      "label": "a note on a fresh selection, bundled with its highlight",
      "method": "POST",
      "path": "/api/v1/read/golden-author/the-golden-path",
      "status": 200,
      "contentType": "application/json",
      "cookie": "none",
      "json": {
        "shape": {
          "ok": "boolean"
        },
        "literals": {
          "ok": true
        }
      }
    },
    {
      "label": "a note with no body is refused",
      "method": "POST",
      "path": "/api/v1/read/golden-author/the-golden-path",
      "status": 400,
      "contentType": "text/plain",
      "cookie": "none"
    },
