{
  "name": "reading-rig",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "react-router dev",
    "build": "react-router build",
    "prestart": "prisma db push && tsx prisma/seed.ts && tsx scripts/ingest.ts app/domain/epub/__fixtures__/capital-volume-i.epub && tsx scripts/ingest.ts app/domain/epub/__fixtures__/pride-and-prejudice.epub",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "ingest": "tsx scripts/ingest.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@react-router/node": "^8",
    "@react-router/serve": "^8",
    "fflate": "^0.8.3",
    "isbot": "^5.1.36",
    "linkedom": "^0.18.13",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@react-router/dev": "^8",
    "@storybook/addon-a11y": "^10.5.4",
    "@storybook/addon-docs": "^10.5.4",
    "@storybook/react-vite": "^10.5.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "chromatic": "^18.1.0",
    "dotenv": "^17.4.2",
    "prisma": "^7.9.0",
    "storybook": "^10.5.4",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^4.1.10"
  }
}
